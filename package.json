{
  "name": "storesy-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @storesy/api",
    "dev:web": "npm run dev --workspace @storesy/frontend",
    "build": "npm run build --workspace @storesy/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @storesy/api",
    "db:migrate:local": "npm run db:migrate:local --workspace @storesy/api",
    "db:migrate:remote": "npm run db:migrate:remote --workspace @storesy/api",
    "bootstrap:account": "bash scripts/bootstrap-account.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vitest": "^4.1.11",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
